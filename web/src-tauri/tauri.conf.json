{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClawPM",
  "version": "0.1.0",
  "identifier": "com.clawpm.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir .. dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir .. build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClawPM",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
