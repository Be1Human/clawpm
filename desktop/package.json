{
  "name": "@clawpm/desktop",
  "version": "0.1.2",
  "description": "ClawPM local-first project management desktop application",
  "author": "ClawPM Contributors",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.clawpm.desktop",
    "productName": "ClawPM",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClawPM",
      "artifactName": "ClawPM-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "typescript": "^5.9.3"
  }
}
