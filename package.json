{
  "name": "clawpm",
  "version": "0.1.8",
  "description": "Local-first Electron project management desktop application",
  "private": true,
  "scripts": {
    "dev": "set CLAWPM_ELECTRON=1&& pnpm --filter web build && pnpm --filter desktop dev",
    "build": "set CLAWPM_ELECTRON=1&& pnpm --filter web build",
    "build:desktop": "set CLAWPM_ELECTRON=1&& pnpm --filter web build && pnpm --filter desktop package",
    "release:preflight": "node scripts/release/preflight.mjs",
    "release:clean": "node scripts/release/clean.mjs",
    "release:build:win": "node scripts/release/build-windows.mjs",
    "test": "pnpm test:workflow && pnpm test:skill-injection",
    "test:workflow": "node --experimental-strip-types --test scripts/tests/task-workflow.test.mjs",
    "test:skill-injection": "node --test scripts/tests/skill-injection.test.mjs",
    "lint": "pnpm --filter web lint"
  },
  "keywords": [
    "project-management",
    "electron",
    "local-first"
  ],
  "license": "MIT"
}
